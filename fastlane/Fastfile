# Fastlane lanes for Shafted (the elevator game) — TestFlight uploads.
#
# Modeled on apple-tv-visualizer's Fastfile, minus what this project does not
# need. Two structural differences, both simplifications:
#
#   * ONE Apple team. The iOS export preset's development signing and this
#     pipeline's distribution signing are both HH3SJBAS42, which is also the
#     account API key 4XBH56T7RS belongs to. No dual-account footnotes here.
#   * ONE Xcode target. The project is GENERATED by Godot (`--export-release
#     "iOS"` with export_project_only), so there are no SwiftPM side targets
#     and signing overrides can ride plain `xcargs` — no AppStore.local.xcconfig
#     dance. The generated project is disposable; nothing here edits the repo.
#
# Run with:  `bundle exec fastlane <lane>`
#
# NOTE: fastlane's dotenv loads `.env` unconditionally, and Claude Code's
# sandbox denies reads of it, so agent-run fastlane invocations need
# `dangerouslyDisableSandbox`. Humans in a terminal are unaffected.

default_platform :ios

# ---------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------
#
# Authentication is an App Store Connect API key, not an Apple ID password —
# 2FA-free, so the same lane works on a laptop and in CI. The key ID and
# issuer ID are checked in deliberately: they *name* the key and authorize
# nothing without the `.p8`, which lives outside every repo at
# ~/.appstoreconnect/private_keys/.
#
# Two keys live in that directory and only ONE is this account's:
#
#   4XBH56T7RS / 22e2fb14-…  — "Sean Perkins", team HH3SJBAS42. THIS app.
#   S2NUTZXN6M / 70960014-…  — Frost Solutions, team 4C8K6B6BHR. Not this app.
TEAM_ID = "HH3SJBAS42"
APP_IDENTIFIER = "com.seanperkins.shafted"

ASC_KEY_ID = ENV.fetch("ASC_KEY_ID", "4XBH56T7RS")
ASC_ISSUER_ID = ENV.fetch("ASC_ISSUER_ID", "22e2fb14-d32b-4837-92b0-6280da32716d")
ASC_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ASC_KEY_ID}.p8")

XCODEPROJ = "build/ios/elevator.xcodeproj"
SCHEME = "elevator"

def asc_api_key
  common = { key_id: ASC_KEY_ID, issuer_id: ASC_ISSUER_ID, in_house: false }

  # CI has no home directory to keep a `.p8` in, so it may pass the key
  # through the environment base64-encoded.
  if ENV["ASC_KEY_CONTENT"].to_s.length > 0
    return app_store_connect_api_key(
      **common,
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  unless File.exist?(ASC_KEY_PATH)
    UI.user_error!(
      "No App Store Connect key at #{ASC_KEY_PATH}. Either put the .p8 there, " \
      "or set ASC_KEY_CONTENT (base64) / ASC_KEY_ID."
    )
  end

  app_store_connect_api_key(**common, key_filepath: ASC_KEY_PATH)
end

# Godot emits the Xcode project fresh on every lane that builds: the project
# under build/ios is an artifact, never a source of truth, and a stale one
# quietly ships yesterday's game.
def export_xcode_project
  sh "cd .. && rm -rf build/ios && mkdir -p build/ios && " \
     "godot --headless --export-release \"iOS\" build/ios/elevator.xcodeproj"
  UI.user_error!("Godot export produced no Xcode project") \
    unless File.exist?("../#{XCODEPROJ}/project.pbxproj")
end

# ---------------------------------------------------------------
# App Store Connect / TestFlight
# ---------------------------------------------------------------

# Cheap pre-flight: authenticates the key and reports what the account
# actually holds. Seconds, no build.
lane :check_credentials do
  asc_api_key

  Spaceship::ConnectAPI.auth(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    filepath: ASC_KEY_PATH
  )

  apps = Spaceship::ConnectAPI::App.all
  UI.message("Key #{ASC_KEY_ID} can see #{apps.count} app(s):")
  apps.each { |a| UI.message("  #{a.bundle_id}  (#{a.name})") }

  if apps.any? { |a| a.bundle_id == APP_IDENTIFIER }
    UI.success("#{APP_IDENTIFIER} found — ready to upload.")
  else
    UI.user_error!(
      "#{APP_IDENTIFIER} has no App Store Connect record. The bundle ID is " \
      "registered (2026-08-05), but the app record cannot be created with an " \
      "API key — App Store Connect does not allow CREATE on /apps. Create it " \
      "by hand at https://appstoreconnect.apple.com → My Apps → + → New App " \
      "(Platform iOS, Bundle ID #{APP_IDENTIFIER}, SKU #{APP_IDENTIFIER})."
    )
  end
end

# Create or fetch the App Store distribution certificate and profile.
#
# Kept separate from the build so a routine build can never mint a certificate
# by accident — an account holds a limited number of Apple Distribution certs
# and `cert` reuses an existing one whenever it can.
lane :certificates do
  api_key = asc_api_key

  cert(
    api_key: api_key,
    team_id: TEAM_ID,
    development: false,
    platform: "ios",
    output_path: "build/fastlane/certs"
  )

  sigh(
    api_key: api_key,
    team_id: TEAM_ID,
    app_identifier: APP_IDENTIFIER,
    platform: "ios",
    development: false,
    output_path: "build/fastlane/profiles"
  )
end

# A signed App-Store .ipa from a fresh Godot export.
#
# The build number comes from TestFlight rather than from the repo or the
# export preset: App Store Connect rejects a CFBundleVersion it has already
# seen, and the preset pins a static `application/version="1"`. The generated
# Info.plist reads `$(CURRENT_PROJECT_VERSION)`, so one xcargs override is the
# whole mechanism. `build_number` may be passed in to override.
lane :build_appstore do |options|
  api_key = asc_api_key

  build_number = options[:build_number] || begin
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    latest.to_i + 1
  end

  # Fetch the App Store profile, read-only: a build must never mint signing
  # material as a side effect. If this fails, run `fastlane certificates`.
  sigh(
    api_key: api_key,
    team_id: TEAM_ID,
    app_identifier: APP_IDENTIFIER,
    platform: "ios",
    development: false,
    readonly: true,
    output_path: "build/fastlane/profiles"
  )
  profile_name = lane_context[SharedValues::SIGH_NAME]

  export_xcode_project

  UI.message("Building CFBundleVersion #{build_number} with profile '#{profile_name}'")

  # Manual signing on the command line. The generated project sets automatic
  # signing with an "Apple Development" identity; a command-line setting beats
  # the project, and with a single target there is nothing else for the
  # override to hit (the visualizer's xcconfig workaround exists because of
  # its SwiftPM targets — not needed here).
  gym(
    scheme: SCHEME,
    project: XCODEPROJ,
    destination: "generic/platform=iOS",
    export_method: "app-store",
    output_directory: "build/fastlane",
    output_name: "shafted",
    derived_data_path: "build/fastlane/DerivedData",
    export_team_id: TEAM_ID,
    export_options: {
      signingStyle: "manual",
      teamID: TEAM_ID,
      provisioningProfiles: { APP_IDENTIFIER => profile_name }
    },
    configuration: "Release",
    xcargs: [
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CODE_SIGN_IDENTITY='Apple Distribution'",
      "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      "CURRENT_PROJECT_VERSION=#{build_number}"
    ].join(" ")
  )
end

# Build + upload to TestFlight.
#
# Stops short of notifying anyone: the build is not distributed to external
# testers here. Adding testers is a deliberate step in App Store Connect.
lane :beta do |options|
  api_key = asc_api_key
  build_appstore(options)

  upload_to_testflight(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    skip_waiting_for_build_processing: false,
    # Export compliance is answered declaratively: Godot writes
    # ITSAppUsesNonExemptEncryption=false into the generated Info.plist, so
    # processing does not stall on a manual question.
    skip_submission: false,
    distribute_external: false,
    notify_external_testers: false
  )
end
